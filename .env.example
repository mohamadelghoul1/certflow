# Copy this file to .env.local and fill in the values from your Supabase
# project (Settings -> API) and your deployed site's URL. See README.md
# for exactly where to find each of these.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Settings -> API -> service_role secret. NEVER put this in NEXT_PUBLIC_*,
# never commit it, never expose it to the browser — it bypasses all
# security rules. Used only server-side, to send client portal invites.
SUPABASE_SERVICE_ROLE_KEY=

# The URL your site is actually reachable at (used to build invite links
# and the login link in notification emails).
# Locally: http://localhost:3000
# On Vercel: your project's https://...vercel.app URL (or custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# resend.com API key, used to send real notification emails (document
# approved, amendment raised, certificate issued, inspection booked, etc.).
# Leave blank and every notification silently no-ops — nothing breaks,
# emails just don't go out until this is set.
RESEND_API_KEY=

# Who notification emails appear to come from. Without your own domain
# verified in Resend, this must stay as the sandbox address below, and
# Resend will only actually deliver to the email you signed up with.
RESEND_FROM_EMAIL="CertFlow <onboarding@resend.dev>"

# Google Cloud API key with the "Places API (New)" enabled, used to show
# address suggestions as you type a project's property address. Kept
# server-side only (never sent to the browser) — the New Project form
# calls our own /api/address-autocomplete route, which calls Google.
# Leave blank and address suggestions silently don't appear; typing the
# address in by hand still works exactly as before.
GOOGLE_PLACES_API_KEY=
