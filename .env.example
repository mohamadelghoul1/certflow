# Copy this file to .env.local and fill in the values from your Supabase
# project (Settings -> API) and your deployed site's URL. See README.md
# for exactly where to find each of these.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Settings -> API -> service_role secret. NEVER put this in NEXT_PUBLIC_*,
# never commit it, never expose it to the browser — it bypasses all
# security rules. Used only server-side, to send client portal invites.
SUPABASE_SERVICE_ROLE_KEY=

# The URL your site is actually reachable at (used to build invite links).
# Locally: http://localhost:3000
# On Vercel: your project's https://...vercel.app URL (or custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
